# Copia este archivo a .env.local (esta en .gitignore) y pon tu llave ahi.
# Ninguna variable es obligatoria: sin llave el agente usa el clasificador
# heuristico (modo fallback) y todo sigue funcionando.

# --- IA: Gemini (recomendado) ---
# Llave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo opcional. Si el que pongas no existe para tu llave, cambialo aqui.
GEMINI_MODEL=gemini-3.8-flash

# --- IA alternativa: Claude (solo se usa si NO hay GEMINI_API_KEY) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Base de datos: Supabase (opcional; sin esto todo vive en memoria) ---
# Supabase > Project Settings > Data API. Pon SOLO la URL base del proyecto,
# SIN /rest/v1 al final (la libreria lo agrega sola). Ejemplo:
#   SUPABASE_URL=https://abcdefghijk.supabase.co
SUPABASE_URL=
# Llave SECRETA (sb_secret_... o la "service_role"). Solo servidor:
# NUNCA con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SECRET_KEY=

# Segundos maximos por llamada a la IA; si se pasa, se usa la heuristica
# (evita que la demo se congele cuando Gemini esta saturado). Default 20.
LLM_TIMEOUT_SECONDS=

# Forzar modo sin IA aunque haya llave: AGENT_MODE=fallback
AGENT_MODE=
# Monto (MXN) a partir del cual se pide revision humana en decisiones delicadas
HIGH_VALUE_MXN=500000

# Supabase se lee una vez al arrancar y luego se trabaja en memoria (rapido).
# Solo si el servidor corre en varias copias (Vercel), pon "always".
SUPABASE_RELOAD=
