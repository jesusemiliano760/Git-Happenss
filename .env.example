# Copia este archivo a .env.local (esta en .gitignore) y pon tu llave ahi.
# Ninguna variable es obligatoria: sin llave el agente usa el clasificador
# heuristico (modo fallback) y todo sigue funcionando.

# --- IA: Gemini (recomendado) ---
# Llave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo opcional. Si el que pongas no existe para tu llave, cambialo aqui.
GEMINI_MODEL=gemini-2.5-flash

# --- IA alternativa: Claude (solo se usa si NO hay GEMINI_API_KEY) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Forzar modo sin IA aunque haya llave: AGENT_MODE=fallback
AGENT_MODE=
# Monto (MXN) a partir del cual se pide revision humana en decisiones delicadas
HIGH_VALUE_MXN=500000
