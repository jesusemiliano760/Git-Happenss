# Copia a .env.local (esta en .gitignore). Ninguna variable es obligatoria:
# sin API key el agente usa el clasificador heuristico (modo fallback).

# Interpretacion de mensajes con Claude (modo live)
ANTHROPIC_API_KEY=
# Modelo (opcional). Default: claude-opus-5-5
ANTHROPIC_MODEL=
# Forzar modo sin IA aunque haya key: AGENT_MODE=fallback
AGENT_MODE=
# Monto (MXN) a partir del cual se pide revision humana en decisiones delicadas
HIGH_VALUE_MXN=500000
